{
    "name": "springimport/magento2-module-catalog-dropdown-sort",
    "description": "All sort options in dropdown in Catalog",
    "type": "magento2-module",
    "license": "MIT",
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Mykhailo Shatilov",
            "email": "mykhailo@springimport.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^5.5 || ^5.6 || ^7.0 || ^8.0",
        "magento/framework": ">=100.0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SpringImport\\CatalogDropdownSort\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
